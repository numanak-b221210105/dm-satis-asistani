# ===== Platform =====
PLATFORM_NAME=DM Satış Asistanı
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/dm_asistan
ADMIN_TOKEN=uzun-rastgele-bir-sifre
# Üretmek için: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# DİKKAT: Bu anahtar kaybolursa/değişirse kayıtlı esnaf token'ları çözülemez.
ENCRYPTION_KEY=

# ===== Meta uygulaması =====
META_VERIFY_TOKEN=webhook-dogrulama-kelimesi
META_APP_SECRET=
GRAPH_API_VERSION=v21.0

# ===== WhatsApp (platformun bildirim hattı) =====
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_TEMPLATE_NAME=
WHATSAPP_TEMPLATE_LANG=tr

# ===== OpenAI =====
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# ===== Mesaj işleme =====
DEBOUNCE_SECONDS=4
HUMANIZER_ENABLED=true

# ===== Veritabanı / bakım =====
AUTO_CREATE_TABLES=true     # Canlıda false; şema `alembic upgrade head` ile yönetilir
RUN_MAINTENANCE=true        # Instagram token yenileme döngüsü
